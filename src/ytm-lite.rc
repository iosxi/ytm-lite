#pragma code_page(65001)
#include <windows.h>
#include "resource.h"

IDI_APP ICON "ytm-lite.ico"
1 RT_MANIFEST "ytm-lite.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     8,0,0,0
PRODUCTVERSION  8,0,0,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041104b0"
        BEGIN
            VALUE "FileDescription",  "ytm-lite - YouTube Music のプレイリストを再生するだけの軽いアプリ"
            VALUE "FileVersion",      "8"
            VALUE "InternalName",     "ytm-lite"
            VALUE "OriginalFilename", "ytm-lite.exe"
            VALUE "ProductName",      "ytm-lite"
            VALUE "ProductVersion",   "8"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x411, 1200
    END
END

IDD_LOGIN DIALOGEX 0, 0, 320, 290
STYLE DS_CENTER | DS_SHELLFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "ログイン情報の設定"
FONT 9, "Yu Gothic UI", 400, 0, 0x80
BEGIN
    LTEXT           "", IDC_FF_HELP, 7, 7, 306, 28
    LTEXT           "Firefox のフォルダ:", -1, 7, 40, 70, 10
    EDITTEXT        IDC_FF_PATH, 7, 51, 248, 14, ES_AUTOHSCROLL | WS_TABSTOP
    PUSHBUTTON      "参照…", IDC_FF_BROWSE, 261, 51, 52, 14, WS_TABSTOP
    DEFPUSHBUTTON   "Firefox から読み込む", IDC_FF_BTN, 7, 72, 100, 16, WS_TABSTOP
    PUSHBUTTON      "music.youtube.com を開く", IDC_FF_OPEN, 113, 72, 110, 16, WS_TABSTOP
    LTEXT           "", IDC_FF_STATUS, 7, 92, 306, 12
    LTEXT           "", IDC_AUTH_HELP, 7, 112, 306, 62
    EDITTEXT        IDC_AUTH_TEXT, 7, 176, 306, 84, ES_MULTILINE | ES_AUTOVSCROLL | ES_WANTRETURN | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "保存", IDOK, 203, 268, 52, 15
    PUSHBUTTON      "閉じる", IDCANCEL, 261, 268, 52, 15
END

IDD_OPENURL DIALOGEX 0, 0, 300, 88
STYLE DS_CENTER | DS_SHELLFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "プレイリストを開く"
FONT 9, "Yu Gothic UI", 400, 0, 0x80
BEGIN
    LTEXT           "", IDC_URL_HELP, 7, 7, 286, 30
    EDITTEXT        IDC_URL, 7, 42, 286, 14, ES_AUTOHSCROLL | WS_TABSTOP
    DEFPUSHBUTTON   "開く", IDOK, 183, 66, 52, 15
    PUSHBUTTON      "キャンセル", IDCANCEL, 241, 66, 52, 15
END
